  "seasons": [
    {
      "letter": "W",
      "name": "Winter",
      "note": "2627W = Winter of 2026–2027",
      "year": "start"
    },
    {
      "letter": "S",
      "name": "Spring",
      "note": "2526S = Spring 2026 (belongs to 2025–2026)",
      "year": "end"
    },
    {
      "letter": "A",
      "name": "Summer (Addition)",
      "note": "2526A = Summer 2026",
      "year": "end"
    },
    {
      "letter": "F",
      "name": "Fall (external courses only)",
      "note": "1617F = Fall 2016",
      "year": "start"
    }
  ],
  "termPlaceholders": [
    {
      "code": "LEGACY",
      "name": "Legacy",
      "note": "Old, mixed-year material of a past offering"
    },
    {
      "code": "Undated",
      "name": "Undated",
      "note": "No real term can be assigned"
    }
  ],
  "tags": [
    {
      "code": "AN",
      "name": "Annotated",
      "note": "A printout you wrote on, then scanned. Keeps the original type."
    },
    {
      "code": "DR",
      "name": "Draft",
      "note": "Rough version of an item that later gets a clean copy. Keeps the final item's type and ID."
    },
    {
      "code": "GR",
      "name": "Graded",
      "note": "Copy with grader marks or a score. Annotated and graded: _AN_GR."
    }
  ],
  "serials": [
    {
      "pattern": "^\\d{2,}$",
      "kind": "Serial",
      "example": "01",
      "note": "Normal serial, at least two digits."
    },
    {
      "pattern": "^\\d{2,}b$",
      "kind": "Supplement",
      "example": "01b",
      "note": "Supplement or complement to item 01."
    },
    {
      "pattern": "^[A-Z]$",
      "kind": "Exam paper",
      "example": "A",
      "note": "Exam paper A / B (PEQ_2526W_A)."
    },
    {
      "pattern": "^Q\\d{2,}b?$",
      "kind": "Quiz",
      "example": "Q01",
      "note": "Quiz (PEA_2526A_Q01)."
    },
    {
      "pattern": "^CA\\d{2,}b?$",
      "kind": "Class assignment",
      "example": "CA01",
      "note": "Class assignment."
    },
    {
      "pattern": "^PS\\d{2,}b?$",
      "kind": "Problem set",
      "example": "PS01",
      "note": "Problem set."
    },
    {
      "pattern": "^P\\d{2,}b?$",
      "kind": "Project",
      "example": "P02",
      "note": "Project."
    },
    {
      "pattern": "^C\\d{2,}b?$",
      "kind": "Chapter",
      "example": "C01",
      "note": "Chapter."
    },
    {
      "pattern": "^FULL$",
      "kind": "Full notes",
      "example": "FULL",
      "note": "A complete notes project for the course (LN_2526A_FULL)."
    }
  ],
  "version": {
    "pattern": "^V\\d{2,}$",
    "example": "V02",
    "note": "Versions of the same item (LBP_2627W_01_V01 old, _V02 new)."
  },
  "uploader": {
    "pattern": "^\\d{9}$",
    "example": "123456789",
    "note": "Your 9-digit student number. It works without registering; register it in uploaders.json to show your name, and add a GitHub username (optional) for a verified badge. It is public."
  },
  "byNotes": {
    "School": "Official course material. The uploader only shares it.",
    "Student": "Written by a student. The student number in the ID says whose work it is.",
    "Published": "A published book or paper.",
    "Scan": "A photo or scan taken by the uploader."
  },
